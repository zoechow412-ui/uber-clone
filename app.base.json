{
  "expo": {
    "name": "安心代駕",
    "description": "香港代駕乘客 App 測試版：由司機駕駛客人自己架車。",
    "githubUrl": "https://github.com/zoechow412-ui/uber-clone",
    "slug": "anxin-designated-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anxin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hk.anxin.designateddriver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "hk.anxin.designateddriver"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      ["expo-splash-screen", {"image":"./assets/images/splash.png","resizeMode":"contain","backgroundColor":"#103C31"}],
      ["expo-location", {"locationWhenInUsePermission": "安心代駕需要你的位置，方便設定接車地點。"}]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
