{
  "expo": {
    "name": "安心代駕",
    "description": "香港代駕乘客 App 測試版：由司機駕駛客人自己架車。",
    "githubUrl": "https://github.com/zoechow412-ui/uber-clone",
    "slug": "anxin-designated-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/anxin-app-icon.png",
    "scheme": "anxin",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "hk.anxin.designateddriver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/anxin-app-icon.png",
        "backgroundColor": "#0B0B0B"
      },
      "package": "hk.anxin.designateddriver"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/anxin-app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0B"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "安心代駕需要你的位置，方便設定接車地點。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
