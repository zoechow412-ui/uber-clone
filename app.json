{
  "expo": {
    "name": "安心代駕",
    "description": "香港乘客版代駕 App（開發測試，非真實派單）",
    "slug": "anxin-designated-driver",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anxin",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#103C31"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hk.anxin.designateddriver",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "安心代駕只會在你使用定位功能時取得目前位置，以協助填寫接車地點。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "hk.anxin.designateddriver"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "安心代駕只會在你使用定位功能時取得目前位置，以協助填寫接車地點。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#103C31"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
