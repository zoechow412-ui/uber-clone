{
  "expo": {
    "name": "安心代駕",
    "description": "香港代客駕駛乘客版本機測試程式，尚未連接真實司機派單及付款。",
    "githubUrl": "https://github.com/zoechow412-ui/uber-clone",
    "slug": "anxin-designated-driver",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anxin",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2F80ED"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hk.anxin.designateddriver",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "安心代駕只會喺你選擇上車位置時使用定位。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "hk.anxin.designateddriver"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "安心代駕只會喺你選擇上車位置時使用定位。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true
  }
}
